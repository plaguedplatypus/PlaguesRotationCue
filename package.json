{
	"name": "rotation-cue",
	"version": "0.1.0",
	"scripts": {
		"build": "npm run typecheck && webpack --mode production && node scripts/copy-dist-to-root.js",
		"test": "node scripts/run-current-tests.js",
		"test:all": "node --test --test-isolation=none tests/rotation.test.js",
		"typecheck": "tsc --noEmit",
		"watch": "webpack --watch --mode development",
		"deploy": "gh-pages -d dist"
	},
	"dependencies": {
		"alt1": "^0.1.3"
	},
	"devDependencies": {
		"@types/node": "^12.12.54",
		"copy-webpack-plugin": "^14.0.0",
		"css-loader": "^7.1.2",
		"gh-pages": "^6.2.0",
		"sharp": "^0.31.3",
		"style-loader": "^4.0.0",
		"ts-loader": "^9.3.1",
		"typescript": "^5.1.3",
		"webpack": "^5.65.0",
		"webpack-cli": "^4.8.0"
	}
}
